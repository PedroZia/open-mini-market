# Copie para .env e ajuste se necessário: o docker compose lê o .env do diretório raiz.
# Os valores abaixo espelham o perfil %dev do backend (backend/src/main/resources/application.properties).
POSTGRES_DB=minimarket
POSTGRES_USER=minimarket
POSTGRES_PASSWORD=minimarket
POSTGRES_PORT=5432
# Porta publicada da API no compose (evita conflito se a 8080 já estiver em uso).
APP_PORT=8080
# Senha do ADMIN inicial do backend (passo 115). Em %dev o backend usa "admin123" quando a variável
# não existe; em %prod e %test não há default — sem ela nenhum ADMIN é semeado. A troca da senha é
# obrigatória no primeiro login.
ADMIN_INITIAL_PASSWORD=admin123
